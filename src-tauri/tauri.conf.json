{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uniins-claw",
  "version": "0.2.0",
  "identifier": "ai.thinkany.uniins-claw",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri-services",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../src-api/dist/codex",
      "../src-api/dist/claude",
      "../src-api/dist/uniins-claw-api"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": [
      "../src-api/dist/cli-bundle/**/*"
    ]
  }
}
